# === Heat Trip 모노레포 루트 .gitignore ===
# app/ 와 backend/ 자체 .gitignore 도 함께 적용됨. 아래는 이중 방어(belt & suspenders).

# --- 비밀: 절대 커밋 금지 ---
**/.env
**/.env.*
!**/.env.example
**/application-private.properties
**/key.properties
**/*.keystore
**/*.jks
**/*.p12
**/*.pem
**/*secret*.json
**/google-services.json

# --- 빌드 산출물 ---
**/build/
**/.gradle/
**/.dart_tool/
**/bin/
**/ephemeral/
**/.plugin_symlinks/

# --- Node (tools 등) ---
**/node_modules/

# --- 에이전트 작업 폴더 ---
# .claude/worktrees 는 병렬 작업용 임시 git worktree 다. 커밋 대상이 아니다.
/.claude/worktrees/

# --- IDE / OS ---
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# --- 로그 / 임시 ---
*.log
tmp/
*.tmp

# docs/ 는 전부 추적한다. 제품 기획 문서(00-product)를 빼 뒀던 것은 ADR-0008 인데,
# 그 결정이 실제로는 "아무도 못 고치는 낡은 문서" 를 만들어서 ADR-0014 가 뒤집었다.

# OpenAPI 제너레이터 산출물 — 생성물은 추적하지 않는다
/backend/generated-reference/

# 블로그 초안 — 발행 전 원고는 저장소 범위 밖
blog/

# Kotlin Gradle 플러그인이 빌드마다 만드는 세션 파일 — 생성물이다
/backend/.kotlin/
