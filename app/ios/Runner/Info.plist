<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pawloop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>heat_trip_flutter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- 위치 사용 문구 — 이슈 #145.

	     이 키가 없으면 iOS 는 권한 프롬프트를 **띄우지 않는다.** geolocator 가 요청해도
	     조용히 거부되고, 앱은 GPS 를 못 잡은 것으로 판단해 시뮬레이션 경로(서울숲 가짜
	     루프)로 떨어진다. 즉 **iOS 에서는 산책 트래킹이 통째로 죽어 있었다.**

	     문구는 심사에서 읽히는 자리다. "왜 필요한가" 를 사용자의 말로 적는다 —
	     "위치가 필요합니다" 같은 문구는 App Store Review Guideline 5.1.1 에서
	     거절 사유가 된다.

	     Always 는 요청하지 않는다. WhenInUse 로 시작한 갱신을 아래 UIBackgroundModes/location 이
	     화면을 끈 뒤에도 이어 준다(#335) — 상단에 파란 표시가 뜬다. Always 가 필요한 것은 앱을
	     켜지 않은 채 위치를 읽는 경우뿐이고 우리는 그러지 않는다. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>산책 경로와 이동 거리를 기록하고, 주변의 반려동물 동반 장소를 보여드리기 위해 위치를 사용해요.</string>
	<!-- 산책을 기록하는 동안 화면을 꺼도 경로가 이어진다(#335). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<!-- 경로 사진을 사진 앱에 저장한다 (이슈 #310). 추가만 하고 읽지 않으므로 Add 키 하나다. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>산책 경로를 그린 사진을 사진 앱에 저장하기 위해 필요해요. 사진을 읽지는 않아요.</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 소셜 로그인 딥링크 복귀용 커스텀 스킴. 이 블록이 없으면 iOS 는
	     heattrip://login-callback 을 어디로 보낼지 몰라 앱으로 돌아오지 못한다. (이슈 #3) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.cetacealab.heattrip</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>heattrip</string>
			</array>
		</dict>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
