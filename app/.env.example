# app/.env 템플릿. 이 파일을 .env 로 복사해 값을 채운다.
#
#   cp app/.env.example app/.env
#
# .env 는 pubspec.yaml 의 assets 에 선언돼 있어 **없으면 빌드가 실패한다**.
# CI 도 이 템플릿을 복사해서 쓴다.
#
# ⚠️ .env 는 앱 번들에 그대로 들어간다. APK 를 풀면 값이 보인다.
#    여기에 진짜 시크릿을 넣지 말 것. → 이슈 #29

# 백엔드 베이스 URL.
# --dart-define=API_BASE=... 가 이 값보다 우선한다.
# 로컬 개발: adb reverse tcp:8080 tcp:8080 후 http://localhost:8080
API_BASE_URL=https://api.heattrip.link

# 한국관광공사 서비스키(인코딩된 형태). 이름과 달리 인코딩키가 들어간다.
# 백엔드 프록시로 옮길 예정 → M3
YOUR_DECODING_SERVICE_KEY=

# 네이버 지도 Dynamic Map Client ID.
# 모바일 SDK 는 Client ID 만 쓰고, 패키지명 허용목록으로 보호된다.
NAVER_MAP_CLIENT_ID=
