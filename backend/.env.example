# Created: 2026-03-18 00:54:24 +09:00
# Copy to .env on the deployment server or local machine.
# Replace every change-me value before running outside local experiments.

# -----------------------------------------------------------------------------
# Spring runtime
# -----------------------------------------------------------------------------
# dev: local development, prod: production/deployment.
SPRING_PROFILES_ACTIVE=dev

# Backend HTTP port and public callback base URL used by OAuth redirect URIs.
SERVER_PORT=8080
APP_BASE_URL=http://10.0.2.2:8080

# Docker host port publishing. Keep localhost for local/dev. Use 0.0.0.0 only
# on staging EC2 when the security group restricts access to the loader.
APP_PUBLISHED_HOST=127.0.0.1
APP_PUBLISHED_PORT=8080

# -----------------------------------------------------------------------------
# Docker MySQL container initialization
# -----------------------------------------------------------------------------
# These values are consumed by docker-compose.yml -> services.mysql.environment.
# They initialize the MySQL container only when the mysql_data volume is first
# created. Changing them later does not update an existing database volume.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=heat_trip_db
MYSQL_USER=heattrip
MYSQL_PASSWORD=change-me-app-password
MYSQL_PUBLISHED_HOST=127.0.0.1
MYSQL_PUBLISHED_PORT=3307

# -----------------------------------------------------------------------------
# Spring datasource
# -----------------------------------------------------------------------------
# These values are consumed by the backend app through application-dev/prod.
# Local bootRun usually uses localhost. Docker Compose overrides these app
# datasource values in docker-compose.yml so the app container connects to the
# mysql service name inside the Compose network.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/heat_trip_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=heattrip
SPRING_DATASOURCE_PASSWORD=change-me-app-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# HS256 needs at least 32 bytes. Use a long random value.
JWT_SECRET=change-me-jwt-secret-with-at-least-32-bytes
JWT_EXPIRATION=3600000
# Refresh token lifetime in ms. Default 1209600000 = 14 days (issue #9).
# This is "how long a user can keep using the app without logging in again",
# so operators are the ones who tune it — it must be discoverable here.
JWT_REFRESH_EXPIRATION=1209600000
# Nightly cleanup of expired refresh_token rows (Spring cron, Asia/Seoul).
# Move it if it collides with another job; there is no way to disable it other
# than pointing it at a time that never comes.
AUTH_REFRESH_TOKEN_PURGE_CRON=0 30 4 * * *

# -----------------------------------------------------------------------------
# OAuth2 clients
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
KAKAO_CLIENT_ID=change-me-kakao-client-id
KAKAO_CLIENT_SECRET=change-me-kakao-client-secret
NAVER_CLIENT_ID=change-me-naver-client-id
NAVER_CLIENT_SECRET=change-me-naver-client-secret

# Sign in with Apple (issue #301) — required before an iOS release (App Store 4.8).
# All four come from Apple Developer (paid membership, USD 99/yr). Leave the last
# three blank until then: the server boots, Kakao/Google keep working, and the
# Apple button comes back to the app as error=apple_not_configured.
# Where to get them (developer.apple.com → Certificates, Identifiers & Profiles):
#   1. Identifiers → App IDs → com.cetacealab.heattrip → tick "Sign in with Apple" → Save.
#   2. Identifiers → "+" → Services IDs → e.g. com.cetacealab.heattrip.signin → Register,
#      open it → enable Sign in with Apple → Configure: Primary App ID = the one above,
#      Domains = the API host, Return URLs = https://<api-host>/login/oauth2/code/apple
#      (https only — Apple rejects http and localhost). That identifier is APPLE_CLIENT_ID.
#   3. Keys → "+" → name it, tick Sign in with Apple → Configure (primary App ID) → Register
#      → Download the .p8 (offered ONCE). The 10-char Key ID on that page is APPLE_KEY_ID.
#   4. Account → Membership details → the 10-char Team ID is APPLE_TEAM_ID.
#   5. APPLE_PRIVATE_KEY = the .p8 file contents with the BEGIN/END lines and line breaks
#      removed (one base64 line). PEM with literal \n also works.
APPLE_CLIENT_ID=change-me-apple-services-id
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
KAKAO_API_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=change-me-kakao-rest-key
TOUR_API_SECRET=change-me-tour-api-key
# Nightly warm-up of the nationwide pet-place catalog (issue #279, Spring cron,
# Asia/Seoul). Without it the first person to open the map after the 24h TTL waits
# for 10 KTO calls (~16s measured). Runs after the refresh-token purge (04:30).
# Set ENABLED=false to drop the job entirely; tests already run with it off.
APP_KTO_CATALOG_WARMUP_ENABLED=true
APP_KTO_CATALOG_WARMUP_CRON=0 40 4 * * *

# -----------------------------------------------------------------------------
# AWS S3 / CloudFront
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=change-me-bucket
AWS_CLOUDFRONT_DOMAIN=https://cdn.example.com

# -----------------------------------------------------------------------------
# LLM recommender
# -----------------------------------------------------------------------------
# Docker internal network example: http://recommender:8000
# Host-local example: http://127.0.0.1:8000
LLM_RECOMMENDER_BASE_URL=http://recommender:8000

# -----------------------------------------------------------------------------
# Public security defaults
# -----------------------------------------------------------------------------
APP_SECURITY_DOCS_PUBLIC=false
APP_SECURITY_ALLOWED_ORIGINS=http://localhost:8080,http://10.0.2.2:8080
APP_SECURITY_RATE_LIMIT_ENABLED=true
APP_SECURITY_RATE_LIMIT_IP_HEADER=X-Forwarded-For
APP_SECURITY_RATE_LIMIT_WINDOW_SECONDS=60
APP_SECURITY_RATE_LIMIT_LOGIN_MAX_REQUESTS=10
APP_SECURITY_RATE_LIMIT_CURATION_MAX_REQUESTS=30
APP_SECURITY_RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
APP_SECURITY_RATE_LIMIT_FEEDBACK_MAX_REQUESTS=30
APP_SECURITY_RATE_LIMIT_SEARCH_MAX_REQUESTS=120

# -----------------------------------------------------------------------------
# Error responses
# -----------------------------------------------------------------------------
SERVER_ERROR_INCLUDE_MESSAGE=never
SERVER_ERROR_INCLUDE_BINDING_ERRORS=never
SERVER_ERROR_INCLUDE_STACKTRACE=never

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Keep ORG_SPRINGFRAMEWORK_WEB at INFO. At DEBUG, Spring's DispatcherServlet logs
# the whole request URL including the query string:
#
#   DEBUG o.s.web.servlet.DispatcherServlet : GET "/api/places/nearby?lat=37.5665&lng=126.9780"
#
# That is the user's live position, on the happy path, every time they open the map.
# It also leaked the KTO serviceKey on outbound calls before issue #192.
#
# application.properties now pins the two leaking child loggers to INFO, so raising
# this no longer leaks — but do not rely on that. Leave it at INFO.
LOG_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO
LOG_LEVEL_ORG_SPRINGFRAMEWORK_HTTP_CONVERTER=INFO
LOG_LEVEL_ORG_SPRINGFRAMEWORK_WEB_MVC_METHOD=INFO
# SQL logging. Keep these OFF outside local debugging (issue #9): raising the
# bind logger to TRACE prints every bound parameter, which includes refresh
# token SHA-256 hashes, user emails, BCrypt hashes and social ids — exactly the
# values convention #6 forbids in logs.
SPRING_JPA_SHOW_SQL=false
LOG_LEVEL_HIBERNATE_SQL=INFO
LOG_LEVEL_HIBERNATE_BIND=INFO

# -----------------------------------------------------------------------------
# Observability integrations
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#backend-alerts
SLACK_BOT_NAME=heat-trip-alert-bot

# -----------------------------------------------------------------------------
# Metrics / local observability stack
# -----------------------------------------------------------------------------
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus,metrics
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_ENDPOINT_PROMETHEUS_ENABLED=true
MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
MANAGEMENT_METRICS_HTTP_HISTOGRAM_ENABLED=true

# docker-compose.observability.yml binds these to 127.0.0.1 by default.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# -----------------------------------------------------------------------------
# k6 local smoke test -> Prometheus remote write
# -----------------------------------------------------------------------------
K6_BASE_URL=http://app:8080
K6_TEST_ID=local-explore-smoke
K6_VUS=1
K6_DURATION=30s
K6_SLEEP_SECONDS=0.2
K6_PROMETHEUS_RW_SERVER_URL=http://prometheus:9090/api/v1/write
K6_PROMETHEUS_RW_TREND_STATS=p(95),p(99),min,max

# -----------------------------------------------------------------------------
# OpenAI / Spring AI
# -----------------------------------------------------------------------------
# 로컬 smoke test에서는 OpenAI를 호출하지 않습니다.
# 실제 환경에서 AI 에러 요약을 쓰려면 필요한 SPRING_AI_MODEL_* 값을 openai로 바꾸고,
# OBSERVABILITY_OPENAI_ENABLED=true와 OPENAI_API_KEY를 secret manager 또는 비공개 .env로 주입합니다.
SPRING_AI_MODEL_CHAT=none
SPRING_AI_MODEL_EMBEDDING=none
SPRING_AI_MODEL_IMAGE=none
SPRING_AI_MODEL_AUDIO_TRANSCRIPTION=none
SPRING_AI_MODEL_AUDIO_SPEECH=none
SPRING_AI_MODEL_MODERATION=none
OBSERVABILITY_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
