# Pawloop prod 의 바깥문 — 이슈 #609 · #613
#
# 밖에서 오는 것은 전부 여기를 지난다. 앱의 8080 은 .env 의 APP_PUBLISHED_HOST=127.0.0.1
# 로 루프백에만 묶이고 보안그룹도 8080 을 안 연다. 그래서 아래 두 가지를 우회할 수 없다.
#
#   1. X-Real-IP 주입  — 없으면 rate limit 이 통째로 무너진다 (아래 설명)
#   2. actuator 차단   — /actuator/prometheus 는 밖에서 보이면 안 된다
#
# 이 파일은 docker-compose.prod.yml 이 읽기 전용으로 물려 준다.
{
	# 인증서 만료 경고가 여기로 온다. 비워 두면 익명 발급이라 경고를 못 받고,
	# 자동 갱신이 조용히 실패하면 어느 날 갑자기 로그인이 전부 죽는다.
	email {$ACME_EMAIL}
}

# ── 앱으로 넘기는 한 자리 — 블루/그린 (이슈 #787) ──────────────────────
#
# 앱이 두 벌(app-blue · app-green)이고 **평소에는 한 벌만 돈다.** 배포할 때만 겹치고,
# 그 사이 Caddy 가 살아 있는 쪽으로 보낸다. 그래서 새 앱의 부팅 시간(약 33초)이
# 사용자에게 안 보인다.
#
# `lb_policy first` — 목록 순서대로, **건강한 첫 번째**에 보낸다. 둘 다 건강하면 blue 다.
#   배포 스크립트가 새 쪽을 띄우고 healthy 를 확인한 뒤 옛 쪽을 내리면, 그 순간부터
#   트래픽이 새 쪽으로 간다. 라운드로빈이 아니라서 **겹치는 동안 버전이 안 섞인다.**
#
# `lb_try_duration` — 옛 쪽이 내려가는 순간의 틈을 메운다. 능동 헬스체크는 3초마다라
#   그 사이에 들어온 요청은 아직 "건강한" 옛 쪽으로 간다. 거기서 실패하면 **같은 요청을
#   다른 쪽으로 다시 보낸다.** 이 줄이 없으면 전환할 때 몇 초가 그대로 에러다.
#
# `header_up X-Real-IP` — **이 줄이 없으면 rate limit 이 사라진다.**
#
#   ClientIpResolver 는 두 벽을 세워 뒀다 (#14).
#     1) 연결 상대가 신뢰 프록시가 아니면 헤더를 아예 안 읽는다
#     2) 읽을 때는 목록의 마지막 원소를 쓴다
#
#   Caddy 는 도커 네트워크 안(172.x)이라 trusted-proxies 의 172.16.0.0/12 에 들어간다 —
#   1번은 통과한다. 그런데 Caddy 는 기본으로 X-Forwarded-For 와 X-Forwarded-Proto 만
#   붙이고 X-Real-IP 는 안 붙인다. 그러면 헤더가 비어 resolve() 가 연결 상대(= Caddy 의
#   IP)로 떨어지고, **전 세계가 카운터 하나를 공유한다.** 로그인 한도 10/분이 서비스
#   전체 합계가 된다 — 증상은 "가끔 로그인이 429" 로만 보인다.
#
#   이 줄을 지워도 아무 에러가 안 난다. 그래서 `CaddyIsTheOnlyDoorTest` 가 잠가 뒀다.
#
# **넘기는 자리가 셋이라 스니펫으로 묶었다.** 세 벌로 적으면 한 곳만 고치고 나머지가
# 뒤처지는 날이 온다.
(app_upstream) {
	reverse_proxy app-blue:8080 app-green:8080 {
		lb_policy first
		lb_try_duration 10s
		lb_try_interval 250ms

		health_uri /actuator/health
		health_interval 3s
		health_timeout 2s

		header_up X-Real-IP {remote_host}
	}
}


{$PAWLOOP_DOMAIN} {
	encode gzip

	# ── actuator ────────────────────────────────────────────────────
	#
	# health 만 통과시킨다. 우리 확인 스크립트가 쓰고, show-details=never 라
	# {"status":"UP"} 뿐이다.
	#
	# 나머지는 막는다. 특히 /actuator/prometheus 는 **공개이면서 rate limit 까지
	# 면제**다 — 지표 수집기가 주기적으로 부르라고 그렇게 둔 것이고, 그 판단의
	# 전제가 "내부망" 이었다. 엔드포인트 이름·호출 수·에러율·JVM·DB 커넥션 상태가
	# 누구에게나, 횟수 제한 없이 나간다.
	#
	# 앱 설정이 아니라 여기서 막는 이유: 서버 안에서는 계속 쓸 수 있어야 한다.
	# `handle` 은 matcher 를 **하나만** 받는다. 경로를 여럿 쓰려면 이름 붙인 matcher 로
	# 묶어야 한다 — `handle /actuator /actuator/*` 라고 쓰면 Caddy 가 설정을 못 읽고
	# 컨테이너가 시작하자마자 죽는다. 실제로 그렇게 죽었다(2026-09-17, 첫 prod 부팅).
	@actuator_public path /actuator/health /actuator/health/*
	handle @actuator_public {
		import app_upstream
	}

	@actuator_all path /actuator /actuator/*
	handle @actuator_all {
		respond 404
	}

	# ── 나머지 전부 ─────────────────────────────────────────────────
	handle {
		import app_upstream
	}

	# ── 나중에 들어올 자리 ──────────────────────────────────────────
	#
	# Apple Services ID 를 만들려면 도메인 소유 확인이 필요하고, 애플이 주는 파일을
	# /.well-known/apple-developer-domain-association.txt 로 내보내야 한다 (#612).
	# 그 파일을 받으면 여기에 handle 블록을 하나 더 둔다.
}

# 소개·약관 페이지 — 이슈 #611. 스토어가 **공개 개인정보처리방침 URL** 을 요구한다.
#
# ## 약관 원문을 여기 안 적는다
#
# `/doc` 은 `app/assets/terms/` 를 그대로 물린 것이다. 앱이 설정 화면에서 읽는 바로 그
# 파일들을 Caddy 가 요청할 때 마크다운으로 그린다({{markdown (include "/doc/…")}}).
#
# **사본을 만들면 반드시 갈라진다.** 갈라진 날 스토어에 올려 둔 쪽이 거짓이 되고, 그건
# 화면이 틀린 것과 달리 법적 문제다. 빌드 단계도 두지 않는다 — 빌드가 있으면 "고쳤는데
# 안 올라간 상태" 가 존재할 수 있다.
#
# 원문(.md)도 `/doc/privacy_ko.md` 로 그대로 열린다. 가릴 이유가 없다.
#
# ## 값이 없을 때 죽지 않게
#
# `{$PAWLOOP_SITE_DOMAIN}` 이 비면 **주소 없는 블록**이 되어 Caddy 가 설정을 못 읽고
# 컨테이너가 시작하자마자 죽는다. 그러면 api 까지 같이 죽는다 — 2026-09-17 첫 prod 부팅에서
# 문법 오류 하나로 그렇게 됐다.
#
# 그래서 기본값을 둔다. 이 이름은 **컨테이너 안에서만** 열리고 인증서도 안 받는다.
# terraform 이 site_domain_name 을 주기 전(또는 안 줄 때)에도 api 는 그대로 산다.
{$PAWLOOP_SITE_DOMAIN:http://localhost:8082} {
	encode gzip
	root * /srv/site

	# 내부 파일. `_head.html` 같은 조각과 마크다운 원본을 직접 열어도 되지만, 조각만
	# 따로 열리면 머리 없는 반쪽 문서가 검색에 잡힌다.
	@partials path /_*.html
	handle @partials {
		respond 404
	}

	# `/privacy` 로 `privacy.html` 을 찾는다. 확장자 없는 주소를 스토어 심사·약관에 적는다.
	try_files {path} {path}.html {path}/index.html
	templates
	file_server
}

# 컨테이너 헬스체크가 두드리는 자리. 밖으로 안 열린다(compose 가 ports 에 안 적는다).
#
# 80 을 두드리면 https 로 되돌리는 308 이 와서 판정이 애매해진다. 그래서 200 만
# 돌려주는 자리를 따로 둔다.
:8081 {
	respond "ok" 200
}


# 서버 안에서 쓰는 문 — 이슈 #787.
#
# 앱이 두 벌이 되면서 **호스트 포트를 더는 앱이 못 묶는다**(둘이 같은 포트를 못 쓴다).
# 그래서 compose 가 이 포트를 Caddy 에 묶고, 여기가 앱으로 넘긴다.
#
# 그러면 서버 안에서 쓰던 것들이 그대로 돈다 —
#   curl 127.0.0.1:8080/actuator/health
# 헬스 확인 스크립트도, 배포 끊김 측정도 고칠 필요가 없다. 오히려 **진짜 경로**(앞단을
# 지나는 길)를 재게 되어 전보다 정확하다.
#
# **actuator 를 안 막는다 — 일부러다.** 이 자리는 예전에 앱이 직접 쓰던 포트를 물려받은
# 것이고, 거기엔 원래 필터가 없었다. 막으면 서버 안에서 지표를 보던 길이 같이 끊긴다.
# 공개 도메인 블록은 위에서 그대로 막고 있다.
#
# 어디까지 열리는지는 `.env` 의 `APP_PUBLISHED_HOST` 가 정한다.
#   운영      127.0.0.1  — 루프백뿐. 밖에서 못 닿는다
#   스테이징  0.0.0.0    — 보안그룹이 허용한 IP 둘에서만 닿는다
# 둘 다 이 변경 전과 같다. 앱이 그 포트를 쥐고 있을 때도 똑같았다.
:8080 {
	encode gzip
	import app_upstream
}
